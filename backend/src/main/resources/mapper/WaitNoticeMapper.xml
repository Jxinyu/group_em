<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gp.mapper.WaitNoticeMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gp.pojo.WaitNotice">
        <id column="n_id" property="nId" />
        <result column="push_way" property="pushWay" />
        <result column="scope" property="scope" />
        <result column="push_date" property="pushDate" />
    </resultMap>
    
    <select id="isExist" resultType="int">
        select count(0) from wait_notice where n_id=#{nId} and scope=#{scope} and push_way=#{pushWay}
    </select>

    <select id="getListByNoticeId" parameterType="int" resultType="waitNotice">
        select *
        from wait_notice where n_id=#{nId};
    </select>

</mapper>
